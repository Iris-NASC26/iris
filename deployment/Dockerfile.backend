# syntax=docker/dockerfile:1
# Iris Python backend (FastAPI). Build context = repository root.
#
# Layout inside the image mirrors the repo, because the code resolves paths
# relative to the repo root:
#   /app/backend    -> code (also holds data/iris_durable_store.json)
#   /app/shared     -> JSON catalogs read by hazards/ and visualization/
#   /app/artifacts  -> runtime caches, SQLite DB, ML models, zarr data
FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app/backend

# Pinned, universal lock generated by uv (Python 3.13).
COPY backend/visualization-requirements.lock ./visualization-requirements.lock
RUN pip install -r visualization-requirements.lock

COPY backend/ /app/backend/
COPY shared/ /app/shared/

# Non-root user; data dirs are bind-mounted/volumes at runtime.
RUN useradd --system --create-home --uid 10001 iris \
    && mkdir -p /app/artifacts /app/backend/data \
    && chown -R iris:iris /app
USER iris

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
    CMD python -c "import urllib.request,sys; urllib.request.urlopen('http://127.0.0.1:8000/openapi.json', timeout=4)" || exit 1

# visualization_app:app = main app + visualization, hazards and forecast routers.
# MUST stay a single worker: forecasts use in-process threads, a SQLite DB and a JSON job store.
CMD ["uvicorn", "visualization_app:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--proxy-headers"]
