# syntax=docker/dockerfile:1
# Iris Next.js dashboard. Build context = repository root.

# ---- deps + build ----
FROM node:22-alpine AS build
RUN apk add --no-cache libc6-compat
WORKDIR /app
# Pin pnpm (project docs use 12.18.0) so corepack doesn't resolve "latest" at build time.
RUN corepack enable && corepack prepare pnpm@12.18.0 --activate

# NEXT_PUBLIC_* values are inlined at BUILD time -> pass as build args.
ARG NEXT_PUBLIC_DOCS_URL=http://localhost:3001
ENV NEXT_PUBLIC_DOCS_URL=$NEXT_PUBLIC_DOCS_URL \
    NEXT_TELEMETRY_DISABLED=1 \
    NEXT_OUTPUT=standalone

# postinstall copies Cesium/MapLibre assets into public/, so scripts/ is needed before install.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY scripts ./scripts
RUN mkdir -p public && pnpm install --frozen-lockfile

COPY . .
RUN pnpm build

# ---- runtime ----
FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0

RUN addgroup -S iris && adduser -S iris -G iris
COPY --from=build --chown=iris:iris /app/.next/standalone ./
COPY --from=build --chown=iris:iris /app/.next/static ./.next/static
COPY --from=build --chown=iris:iris /app/public ./public
USER iris

EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD wget -qO- http://127.0.0.1:3000/ >/dev/null || exit 1

CMD ["node", "server.js"]
