# Copy to deployment/backend.env (chmod 600). Never commit. Never use NEXT_PUBLIC_ for secrets.

# Conversational SI / assistant (Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# NASA Earthdata (CMR/Harmony/AppEEARS)
EARTHDATA_TOKEN=
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# NOAA CDO
NOAA_CDO_TOKEN=

# Copernicus CDS
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=

# Meteomatics (hazards rainfall)
METEOMATICS_USERNAME=
METEOMATICS_PASSWORD=

# Protects ML admin endpoints; set a long random string (openssl rand -hex 32)
IRIS_ML_ADMIN_TOKEN=
