{
  "name": "@earth-trend/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/next.mjs dev",
    "check": "tsc --noEmit",
    "test": "vitest run && node --test scripts/contracts.test.mjs",
    "build": "node scripts/next.mjs build",
    "test:browser": "playwright test",
    "contracts:generate": "node scripts/contracts.mjs",
    "contracts:check": "node scripts/contracts.mjs --check",
    "start": "node scripts/next.mjs start"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "31.0.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
